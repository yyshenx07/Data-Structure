#include <iostream>
using namespace std;

struct Node {
    int val;
    Node* next;
    Node(int v) : val(v), next(nullptr) {}
};

class LinkedList {
private:
    Node* head;   // 头结点，不存有效数据
    int length;

public:
    LinkedList() {
        head = new Node(0);
        length = 0;
    }

    ~LinkedList() {
        clear();
        delete head;
    }

    void clear() {
        Node* p = head->next;
        while (p) {
            Node* q = p->next;
            delete p;
            p = q;
        }
        head->next = nullptr;
        length = 0;
    }

    // 头插法
    void insertHead(int val) {
        Node* node = new Node(val);
        node->next = head->next;
        head->next = node;
        ++length;
    }

    // 尾插法
    void insertTail(int val) {
        Node* p = head;
        while (p->next) p = p->next;
        p->next = new Node(val);
        ++length;
    }

    // 按位插入，pos 从 1 开始
    bool insert(int pos, int val) {
        if (pos < 1 || pos > length + 1) return false;

        Node* p = head;
        for (int i = 0; i < pos - 1; ++i) {
            p = p->next;
        }

        Node* node = new Node(val);
        node->next = p->next;
        p->next = node;
        ++length;
        return true;
    }

    // 按位删除，pos 从 1 开始
    bool erase(int pos, int& e) {
        if (pos < 1 || pos > length) return false;

        Node* p = head;
        for (int i = 0; i < pos - 1; ++i) {
            p = p->next;
        }

        Node* q = p->next;
        e = q->val;
        p->next = q->next;
        delete q;
        --length;
        return true;
    }

    // 按值查找，返回第一个找到的结点指针
    Node* find(int val) {
        Node* p = head->next;
        while (p && p->val != val) {
            p = p->next;
        }
        return p;
    }

    // 反转单链表
    void reverse() {
        Node* pre = nullptr;
        Node* cur = head->next;

        while (cur) {
            Node* nxt = cur->next;
            cur->next = pre;
            pre = cur;
            cur = nxt;
        }

        head->next = pre;
    }

    void print() {
        Node* p = head->next;
        cout << "[";
        while (p) {
            cout << p->val;
            if (p->next) cout << ", ";
            p = p->next;
        }
        cout << "]\n";
    }

    int size() const {
        return length;
    }
};

int main() {
    LinkedList list;

    list.insertHead(2);
    list.insertHead(1);
    list.insertTail(3);
    list.insertTail(4);
    list.print();  // [1, 2, 3, 4]

    list.insert(2, 99);
    list.print();  // [1, 99, 2, 3, 4]

    int e;
    list.erase(2, e);
    cout << "deleted: " << e << "\n";
    list.print();  // [1, 2, 3, 4]

    list.reverse();
    list.print();  // [4, 3, 2, 1]

    return 0;
}
