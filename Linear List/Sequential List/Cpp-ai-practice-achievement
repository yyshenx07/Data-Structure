#include <iostream>
#include <stdexcept>
using namespace std;

#define ElemType int
#define INIT_SIZE 10

class SeqList {
private:
    ElemType* data;
    int length;
    int capacity;

    void resize() {
        capacity *= 2;
        ElemType* newData = new ElemType[capacity];
        for (int i = 0; i < length; ++i) newData[i] = data[i];
        delete[] data;
        data = newData;
    }

public:
    SeqList() {
        data = new ElemType[INIT_SIZE];
        length = 0;
        capacity = INIT_SIZE;
    }

    ~SeqList() { delete[] data; }

    bool insert(int pos, ElemType val) {
        if (pos < 1 || pos > length + 1) return false;
        if (length == capacity) resize();

        for (int i = length; i >= pos; --i) {
            data[i] = data[i - 1];
        }
        data[pos - 1] = val;
        ++length;
        return true;
    }

    bool erase(int pos, ElemType& e) {
        if (pos < 1 || pos > length) return false;
        e = data[pos - 1];
        for (int i = pos; i < length; ++i) {
            data[i - 1] = data[i];
        }
        --length;
        return true;
    }

    int locate(ElemType val) const {
        for (int i = 0; i < length; ++i) {
            if (data[i] == val) return i + 1;
        }
        return 0;
    }

    ElemType get(int pos) const {
        if (pos < 1 || pos > length) throw out_of_range("pos error");
        return data[pos - 1];
    }

    int size() const { return length; }

    void print() const {
        cout << "[";
        for (int i = 0; i < length; ++i) {
            cout << data[i];
            if (i != length - 1) cout << ", ";
        }
        cout << "]\n";
    }
};

int main() {
    SeqList list;
    for (int i = 1; i <= 15; ++i) list.insert(i, i * 10);
    list.print();

    list.insert(1, 5);
    list.print();

    ElemType e;
    list.erase(3, e);
    cout << "deleted: " << e << "\n";
    list.print();

    cout << "locate 50: " << list.locate(50) << "\n";
    cout << "get 5: " << list.get(5) << "\n";
    return 0;
}
