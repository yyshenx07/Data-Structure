 class SeqList:
    def __init__(self, capacity=10):
        self.data = [None] * capacity
        self.length = 0
        self.capacity = capacity

    def _resize(self):
        self.capacity *= 2
        new_data = [None] * self.capacity
        for i in range(self.length):
            new_data[i] = self.data[i]
        self.data = new_data

    def insert(self, pos, val):
        if pos < 1 or pos > self.length + 1:
            return False
        if self.length == self.capacity:
            self._resize()
        for i in range(self.length, pos - 1, -1):
            self.data[i] = self.data[i - 1]
        self.data[pos - 1] = val
        self.length += 1
        return True

    def erase(self, pos):
        if pos < 1 or pos > self.length:
            return None
        e = self.data[pos - 1]
        for i in range(pos - 1, self.length - 1):
            self.data[i] = self.data[i + 1]
        self.length -= 1
        return e

    def locate(self, val):
        for i in range(self.length):
            if self.data[i] == val:
                return i + 1
        return 0

    def get(self, pos):
        if pos < 1 or pos > self.length:
            raise IndexError("pos error")
        return self.data[pos - 1]

    def __str__(self):
        return "[" + ", ".join(str(self.data[i]) for i in range(self.length)) + "]"


